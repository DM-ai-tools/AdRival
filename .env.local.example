SOCIAVAULT_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=perplexity/sonar
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
OPENAI_CONTENT_MODEL=gpt-4.1
# Brandfetch Brand API (logos + palette + fonts). Free tier: https://developers.brandfetch.com
BRANDFETCH_API_KEY=
FIRECRAWL_API_KEY=
# RunwayML API — GPT Image 2 for landing-page photo generation
# https://docs.dev.runwayml.com/api/#tag/Start-generating/paths/~1v1~1text_to_image/post
RUNWAYML_API_SECRET=
# Optional absolute origin for embedded /generated image URLs (defaults to localhost:3000)
NEXT_PUBLIC_APP_URL=http://localhost:3000
HISTORY_IMPORT_SECRET=

# HMAC secret for session cookies. Required in production.
SESSION_SECRET=

# First-admin bootstrap. Set both, visit /setup once, then remove the token.
ADMIN_BOOTSTRAP_TOKEN=
ADMIN_BOOTSTRAP_USERNAME=

# Landing page recreation: "manus" uses the Manus design agent, "unified" (or unset) the built-in pipeline.
RECREATE_PIPELINE=
# Manus API key (https://manus.im/app#settings/developers)
MANUS_API_KEY=
# Optional: Manus agent profile (standard = Manus 2.0 standard, lite, or max = more credits) and run time limit in minutes
MANUS_AGENT_PROFILE=standard
MANUS_TIMEOUT_MINUTES=90
# Manus project (cloud folder) every recreate task is created in; MANUS_PROJECT_ID overrides the name
MANUS_PROJECT_NAME=redeisgn pipeline
