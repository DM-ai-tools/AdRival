SOCIAVAULT_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=perplexity/sonar
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
OPENAI_CONTENT_MODEL=gpt-4.1
# Brandfetch Brand API (logos + palette + fonts). Free tier: https://developers.brandfetch.com
BRANDFETCH_API_KEY=
FIRECRAWL_API_KEY=
# RunwayML API — GPT Image 2 for landing-page photo generation
# https://docs.dev.runwayml.com/api/#tag/Start-generating/paths/~1v1~1text_to_image/post
RUNWAYML_API_SECRET=
# Optional absolute origin for embedded /generated image URLs (defaults to localhost:3000)
NEXT_PUBLIC_APP_URL=http://localhost:3000
HISTORY_IMPORT_SECRET=

# HMAC secret for session cookies. Required in production.
SESSION_SECRET=

# First-admin bootstrap. Set both, visit /setup once, then remove the token.
ADMIN_BOOTSTRAP_TOKEN=
ADMIN_BOOTSTRAP_USERNAME=

# Landing page recreation uses the Manus design agent.
# Manus API key (https://manus.im/app#settings/developers)
MANUS_API_KEY=
# Optional: Manus agent profile (standard = Manus 2.0 standard, lite, or max = more credits) and run time limit in minutes
MANUS_AGENT_PROFILE=standard
MANUS_TIMEOUT_MINUTES=90
# Manus project (cloud folder) for recreate tasks; defaults to "redeisgn pipeline". MANUS_PROJECT_ID overrides the name.
MANUS_PROJECT_NAME=redeisgn pipeline

# Google / YouTube keyword searches: a Manus agent reads Google's sponsored results in the run's country
# and checks each advertiser in the Ads Transparency Center (on whenever MANUS_API_KEY is set).
# MANUS_SEARCH=off goes back to the web search only. Profile defaults to lite (Manus 2.0 lite);
# the time limit is per step (each local ring, country-wide, the "find more" round).
# MANUS_SEARCH=off
MANUS_SEARCH_PROFILE=lite
MANUS_SEARCH_TIMEOUT_MINUTES=20
# Manus project (cloud folder) for search tasks; defaults to "Google Comp - AdRival". MANUS_SEARCH_PROJECT_ID overrides the name.
MANUS_SEARCH_PROJECT_NAME=Google Comp - AdRival

# Admin panel spend: USD per credit/request for providers billed that way (defaults = published entry-plan prices).
# Set these to your plan's real rate. OpenAI/Anthropic spend needs their admin keys (no balance API exists).
# SOCIAVAULT_USD_PER_CREDIT=0.00483
# FIRECRAWL_USD_PER_CREDIT=0.0038
# BRANDFETCH_USD_PER_REQUEST=0.04
# MANUS_USD_PER_CREDIT=0.005
# RUNWAY_USD_PER_CREDIT=0.01
# OPENAI_ADMIN_KEY=
# ANTHROPIC_ADMIN_KEY=
