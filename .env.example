# --- Database (Postgres on Supabase) ---
# Local dev now needs a Postgres too: the JSON file store is gone, so set
# DATABASE_URL (a local Postgres works) before running the app.
# Runtime connection: Supabase transaction pooler (port 6543).
DATABASE_URL=
# Direct/session connection (port 5432): used for migrations at start (falls
# back to DATABASE_URL when unset) and as the default --url of the scripts
# (import:store, verify:import, backup:run). The in-app nightly backup and
# POST /api/admin/backup use DATABASE_URL, not this one.
DATABASE_DIRECT_URL=
# Optional: direct URL of a scratch Supabase project for the staging concurrency
# tests. The tests create and drop their own schema in it.
DATABASE_TEST_URL=
# Supabase Storage (archived recreated pages, backups)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Days before a recreated page's HTML moves to Storage (default 14)
RECREATED_PAGE_ARCHIVE_DAYS=14
# Only used for uploaded recreate assets now (images on the Railway volume);
# all other data lives in Postgres.
ADRIVAL_DATA_DIR=

SOCIAVAULT_API_KEY=
OPENAI_API_KEY=
# Model for A/B portal labels and ICPs (direct OpenAI API, needs OPENAI_API_KEY). Default gpt-4o-mini.
AB_OPENAI_MODEL=

# OpenRouter (Perplexity Sonar for business URL / industry analysis)
# https://openrouter.ai/docs — model: perplexity/sonar
OPENROUTER_API_KEY=
OPENROUTER_MODEL=perplexity/sonar
OPENROUTER_SITE_URL=https://adrival.up.railway.app
OPENROUTER_APP_NAME=AdRival

# Anthropic Claude — fallback CID text rewrite if approved content missing
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# OpenAI — phase-1 landing content pack (high context). Default gpt-4.1
OPENAI_CONTENT_MODEL=gpt-4.1

# Brandfetch Brand API — logos, colour palette, fonts
# https://developers.brandfetch.com
BRANDFETCH_API_KEY=

# Firecrawl — scrape business site for real nav/footer/social/service links
# https://docs.firecrawl.dev
FIRECRAWL_API_KEY=

# Landing-page images. With OPENAI_API_KEY set, images come straight from
# OpenAI's Image API (gpt-image-2). OPENAI_IMAGE_MODEL overrides the model;
# IMAGE_PROVIDER=runway forces Runway instead.
# https://developers.openai.com/api/docs/models/gpt-image-2
OPENAI_IMAGE_MODEL=gpt-image-2
IMAGE_PROVIDER=
# RunwayML — fallback image provider (also serves GPT Image 2)
# https://docs.dev.runwayml.com/api/#tag/Start-generating/paths/~1v1~1text_to_image/post
RUNWAYML_API_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# One-time / admin history import (set on Railway, then remove after import).
# Remove it at the Postgres cutover: the import's default "replace" mode would
# wipe runs created after it.
HISTORY_IMPORT_SECRET=

# Maintenance switch: 1 answers every request except /api/health with 503
# (JSON for /api, a short page otherwise). Used for the cutover window.
MAINTENANCE_MODE=

# --- Script-only variables (never on Railway) ---
# The TypeScript scripts (import:store, verify:import, backup:*, loadtest) load
# .env.local, then .env, themselves; variables set in the terminal win.
# scripts/import-history.mjs does NOT read env files: export these two in the
# terminal (or pass --url / --owner).
# scripts/import-history.mjs: the deployed app's base URL (or --url) ...
ADRIVAL_URL=
# ... and the fallback owner username for runs without a match (or --owner).
IMPORT_OWNER=
# npm run loadtest: JSON array of test logins, e.g.
# [{"username":"lt1","password":"..."}]
LOADTEST_USERS=

# HMAC secret for session cookies. Required in production.
SESSION_SECRET=

# First-admin bootstrap. Set both, visit /setup once, then remove the token.
# See docs/MULTI_USER.md
ADMIN_BOOTSTRAP_TOKEN=
ADMIN_BOOTSTRAP_USERNAME=

# Deprecated: team password login replaced by user accounts (username + password in DB)
# LOGIN_PASSWORD=
