SOCIAVAULT_API_KEY=
OPENAI_API_KEY=

# OpenRouter (Perplexity Sonar for business URL / industry analysis)
# https://openrouter.ai/docs — model: perplexity/sonar
OPENROUTER_API_KEY=
OPENROUTER_MODEL=perplexity/sonar
OPENROUTER_SITE_URL=https://adrival.up.railway.app
OPENROUTER_APP_NAME=AdRival

# Anthropic Claude — fallback CID text rewrite if approved content missing
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# OpenAI — phase-1 landing content pack (high context). Default gpt-4.1
OPENAI_CONTENT_MODEL=gpt-4.1

# Brandfetch Brand API — logos, colour palette, fonts
# https://developers.brandfetch.com
BRANDFETCH_API_KEY=

# Firecrawl — scrape business site for real nav/footer/social/service links
# https://docs.firecrawl.dev
FIRECRAWL_API_KEY=

# RunwayML — GPT Image 2 for landing-page photo generation during design build
# https://docs.dev.runwayml.com/api/#tag/Start-generating/paths/~1v1~1text_to_image/post
RUNWAYML_API_SECRET=
NEXT_PUBLIC_APP_URL=http://localhost:3000

# One-time / admin history import (set on Railway, then remove after import)
HISTORY_IMPORT_SECRET=
